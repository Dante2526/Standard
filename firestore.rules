rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    function isValidDateString(dateStr) {
      return dateStr is string &&
        dateStr.matches("^\\d{4}-\\d{2}-\\d{2}.*$");
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /kaizens/{kaizenId} {
      // Bloqueia acesso se não estiver autenticado
      allow read: if isAuthenticated();
      
      // Validação rigorosa na criação e atualização
      allow create, update: if isAuthenticated() && 
        hasRequiredFields(['matricula', 'title', 'date', 'status', 'impact', 'createdAt']) &&
        validStringLength('matricula', 1, 50) &&
        validStringLength('title', 1, 500); // Título pode ser longo
      
      allow delete: if isAuthenticated();
    }

    match /estagios/{matricula} {
      allow read: if isAuthenticated();
      
      // Validação de estrutura para evitar corrupção de dados
      allow create, update: if isAuthenticated() && 
        hasRequiredFields(['matricula', 'horasAcumuladas', 'status', 'tableRows']) &&
        request.resource.data.horasAcumuladas is number &&
        request.resource.data.tableRows is list;
        
      allow delete: if isAuthenticated();
    }

    match /global_files/{fileId} {
      // FECHADO: Apenas usuários autenticados podem ler arquivos globais
      // Isso protege contra vazamento de dados de planilhas para o público geral
      allow read: if isAuthenticated();
      
      // Apenas usuários autenticados podem subir arquivos
      allow write: if isAuthenticated();
    }

    // Regras padrão para outras coleções (bloqueio total por padrão)
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Abrir coleções legadas do banco antigo apenas para leitura autenticada
    match /administrators/{adminId} { allow read: if isAuthenticated(); }
    match /turma a/{id} { allow read: if isAuthenticated(); }
    match /turma b/{id} { allow read: if isAuthenticated(); }
    match /turma c/{id} { allow read: if isAuthenticated(); }
    match /turma d/{id} { allow read: if isAuthenticated(); }
  }
}
