rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: kaizens
    // Document ID: auto-generated
    // Fields:
    //   - matricula: string (required, max 50 chars)
    //   - title: string (required, max 200 chars)
    //   - date: string (required, ISO 8601 date format)
    //   - status: string (required, max 50 chars)
    //   - impact: string (required, max 100 chars)
    //   - createdAt: string (required, ISO 8601 date-time format)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    function isValidDateString(dateStr) {
      return dateStr is string &&
        dateStr.matches("^\\d{4}-\\d{2}-\\d{2}.*$");
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidKaizen() {
      return hasRequiredFields(['matricula', 'title', 'date', 'status', 'impact', 'createdAt']) &&
             hasOnlyAllowedFields(['matricula', 'title', 'date', 'status', 'impact', 'createdAt']) &&
             validStringLength('matricula', 1, 50) &&
             validStringLength('title', 1, 200) &&
             isValidDateString(request.resource.data.date) &&
             validStringLength('status', 1, 50) &&
             validStringLength('impact', 1, 100) &&
             isValidDateString(request.resource.data.createdAt);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /kaizens/{kaizenId} {
      // Allow read for authenticated users (since we want to display them)
      allow read: if isAuthenticated();
      
      // Allow create if authenticated and data is valid
      allow create: if isAuthenticated() && isValidKaizen();
      
      // Allow update if authenticated, data is valid, and createdAt is unchanged
      allow update: if isAuthenticated() && isValidKaizen() && areImmutableFieldsUnchanged(['createdAt']);
      
      // Allow delete if authenticated (can be restricted further if needed)
      allow delete: if isAuthenticated();
    }

    match /estagios/{matricula} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && hasRequiredFields(['matricula', 'horasAcumuladas', 'status', 'dataInicio', 'ultimaAtualizacao']);
      allow delete: if isAuthenticated();
    }

    match /global_files/{fileId} {
      allow read: if true; // anyone can download
      allow write: if isAuthenticated(); // only authenticated can upload
    }
  }
}
